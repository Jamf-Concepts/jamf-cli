            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceReportDto"
                }
              }
            },
            "description": "Successfully retrieved the device report",
            "headers": {
              "Deprecation": {
                "description": "RFC 9745 deprecation timestamp",
                "schema": {
                  "example": "@1778976000",
                  "type": "string"
                },
                "style": "simple"
              },
              "Link": {
