{
  "components": {
    "headers": {
      "traceId": {
        "description": "Trace ID for correlating this request across Tyk, JAG, and the backend service (ADG-400). Include this value when reporting issues to Jamf support.\n",
        "schema": {
          "example": "ecf2ca07e23c0abc12393472f2b783df",
          "type": "string"
        }
      }
    },
    "parameters": {
      "tenantId": {
        "description": "The tenant UUID identifier",
        "in": "path",
        "name": "tenantId",
        "required": true,
        "schema": {
          "example": "e77c1408-10c8-4007-b177-abc9157fbcaa",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        }
      }
    },
    "responses": {
      "tooManyRequests": {
        "content": {
          "application/json": {
            "example": {
              "errors": [
                {
                  "code": "RATE_LIMIT_EXCEEDED",
                  "description": "Too many requests. Retry after the indicated period."
                }
              ],
              "httpStatus": 429,
              "traceId": "ecf2ca07e23c0abc12393472f2b783df"
            },
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        },
        "description": "Rate limit exceeded. Retry after the period indicated by `Retry-After`.",
        "headers": {
          "Retry-After": {
            "description": "Number of seconds to wait before retrying.",
            "schema": {
              "type": "integer"
            }
          },
          "X-B3-TraceId": {
            "$ref": "#/components/headers/traceId"
          }
        }
      }
    },
    "schemas": {
      "ApiError": {
        "description": "Standard error response body per ADG-54. Returned for all non-2xx responses. The `traceId` field matches the `X-B3-TraceId` response header (ADG-400).\n",
        "properties": {
          "errors": {
            "description": "One entry per problem in the request.",
            "items": {
              "properties": {
                "code": {
                  "description": "Machine-readable error code.",
                  "example": "RATE_LIMIT_EXCEEDED",
                  "type": "string"
                },
                "description": {
                  "description": "Human-readable description for debugging. Do not display to end users.",
                  "example": "Too many requests. Retry after the indicated period.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "httpStatus": {
            "example": 400,
            "type": "integer"
          },
          "traceId": {
            "description": "Trace ID for correlating this error across Tyk, JAG, and the backend service. Matches the `X-B3-TraceId` response header.\n",
            "example": "ecf2ca07e23c0abc12393472f2b783df",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Category": {
        "description": "A content category from `content-block-service`. Use `displayName` as `categoryName` when creating or updating an App — TRS validates against `displayName`, not `name`.\n",
        "properties": {
          "displayName": {
            "description": "Human-readable label (e.g. `\"Social\"`). This is the value to pass as `categoryName` when creating or updating an App — TRS validates `categoryName` against this field via `ContentBlockServiceClient.getCategories()` which maps `Category::getDisplayName`.\n",
            "type": "string"
          },
          "id": {
            "description": "Unique category identifier.",
            "type": "string"
          },
          "name": {
            "description": "Machine-readable slug (e.g. `social`). Informational only — **do not use as `categoryName`**; TRS validates against `displayName`, not `name`.\n",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "displayName"
        ],
        "type": "object"
      },
      "CategoryListResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/Category"
            },
            "type": "array"
          },
          "totalCount": {
            "description": "Total number of content categories available to this tenant.",
            "type": "integer"
          }
        },
        "required": [
          "totalCount",
          "results"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "JWT Bearer token authentication. Obtain a token from the Jamf API Gateway.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Jamf Developer",
      "url": "https://developer.jamf.com"
    },
    "description": "Generic JSC content categories — used as categoryName in ZTNA Apps",
    "termsOfService": "https://www.jamf.com/developer-resources/api-license-agreement/",
    "title": "Jamf JSC Categories API (STAGE)",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/tenant/{tenantId}/categories": {
      "get": {
        "description": "List all content categories available to this tenant. Not paginated.\n\n**Required Permissions:** `read:jsc:all`",
        "operationId": "listCategories",
        "parameters": [
          {
            "$ref": "#/components/parameters/tenantId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "results": [
                    {
                      "displayName": "Social",
                      "id": "abc123",
                      "name": "social"
                    },
                    {
                      "displayName": "Business \u0026 Industry",
                      "id": "def456",
                      "name": "business-and-industry"
                    }
                  ],
                  "totalCount": 2
                },
                "schema": {
                  "$ref": "#/components/schemas/CategoryListResponse"
                }
              }
            },
            "description": "List of content categories.",
            "headers": {
              "X-B3-TraceId": {
                "$ref": "#/components/headers/traceId"
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/tooManyRequests"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List Categories",
        "tags": [
          "Categories"
        ],
        "x-authentication-required": true,
        "x-required-privileges": [
          "read:jsc:all"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "description": "Jamf Beta API Gateway - stage",
      "url": "https://{region}.stage.apigw.jamfnebula.com/api/securitycloud",
      "variables": {
        "region": {
          "default": "us",
          "description": "Geographic deployment region",
          "enum": [
            "us",
            "eu",
            "apac"
          ]
        }
      }
    }
  ],
  "tags": [
    {
      "description": "JSC content categories. **List only** — no get-by-id.\n",
      "name": "Categories"
    }
  ],
  "x-jamf-tenant-path-version": "v1"
}
