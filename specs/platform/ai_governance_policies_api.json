    "/v1/policies/{policyId}/publish": {
      "parameters": [
        {
          "$ref": "#/components/parameters/PolicyId"
        }
      ],
      "post": {
        "description": "Snapshots the current draft settings into a new immutable PolicyVersion. Returns\n409 if the draft settings match the latest published version (no changes to\npublish). The publish re-validates settings against the vendor schema before\ncreating the version.\n\n\n**Required Permissions:** `ai-policies:update`",
        "operationId": "publishPolicy",
        "parameters": [
          {
            "$ref": "#/components/parameters/X-Environment-Id"
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResponse"
                }
              }
            },
            "description": "Version published",
            "headers": {
              "Location": {
                "description": "URL of the created policy version",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "No draft to publish — draft settings match the latest published version"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          }
        },
        "security": [
          {
            "oauth2": [
              "ai-policies:update"
            ]
          }
        ],
        "summary": "Publish current draft settings as a new immutable PolicyVersion",
        "tags": [
          "policies"
        ],
        "x-action": true,
        "x-required-privileges": [
          "ai-policies:update"
        ]
      }
    },
