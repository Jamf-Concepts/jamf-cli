{
  "openapi": "3.0.1",
  "info": {
    "title": "Device Inventory API",
    "description": "Management API for device inventory - Query and manage devices across your organization",
    "version": "1.0.0",
    "termsOfService": "https://www.jamf.com/developer-resources/api-license-agreement/",
    "contact": {
      "name": "Jamf Developer",
      "url": "https://developer.jamf.com"
    }
  },
  "paths": {
    "/v1/tenant/{tenantId}/devices": {
      "get": {
        "summary": "Get all devices",
        "description": "Retrieve a paginated list of all devices\n\n**Required Permissions:** `read:pro:devices`",
        "tags": [
          "devices"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/tenantId"
          },
          {
            "$ref": "#/components/parameters/PageIndex"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "$ref": "#/components/parameters/DeviceSort"
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter query in RSQL format. Includes all results, by default.</br> Fields allowed in the query: `id`, `name`, `model`, `modelIdentifier`, `serialNumber`, `lastInventoryUpdateTime`, `lastCheckInTime`, `operatingSystemVersion`, `enrollmentType`, `lastEnrollmentTime`.</br> Dates are specified in ISO 8601 format.</br> Example: `name==\"*iPhone*\" and lastInventoryUpdateTime>=\"2025-01-31T18:09:00.000Z\"`",
            "schema": {
              "type": "string",
              "default": ""
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of devices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedDeviceResponseRepresentation"
                }
              }
            }
          }
        },
        "x-authentication-required": true,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-privileges": [
          "read:pro:devices"
        ]
      }
    },
    "/v1/tenant/{tenantId}/devices/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DeviceId"
        }
      ],
      "get": {
        "summary": "Get a device by ID",
        "description": "Retrieve a specific device by its ID\n\n**Required Permissions:** `read:pro:devices`",
        "tags": [
          "devices"
        ],
        "responses": {
          "200": {
            "description": "Device found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceReadRepresentationV1"
                }
              }
            }
          },
          "404": {
            "description": "The requested device could not be found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorRepresentation"
                }
              }
            }
          }
        },
        "x-authentication-required": true,
        "parameters": [
          {
            "$ref": "#/components/parameters/tenantId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Path parameter id"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-privileges": [
          "read:pro:devices"
        ]
      },
      "patch": {
        "summary": "Update a device",
        "description": "Update an existing device\n\n**Required Permissions:** `update:pro:devices`",
        "tags": [
          "devices"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceUpdateRepresentationV1"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Device updated successfully"
          },
          "404": {
            "description": "The requested device could not be found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorRepresentation"
                }
              }
            }
          }
        },
        "x-authentication-required": true,
        "parameters": [
          {
            "$ref": "#/components/parameters/tenantId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Path parameter id"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-privileges": [
          "update:pro:devices"
        ]
      },
      "delete": {
        "summary": "Delete a device",
        "description": "Delete an existing device\n\n**Required Permissions:** `delete:pro:devices`",
        "tags": [
          "devices"
        ],
        "responses": {
          "204": {
            "description": "Device deleted successfully"
          },
          "404": {
            "description": "The requested device could not be found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorRepresentation"
                }
              }
            }
          },
          "422": {
            "description": "The device could not be deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorRepresentation"
                }
              }
            }
          }
        },
        "x-authentication-required": true,
        "parameters": [
          {
            "$ref": "#/components/parameters/tenantId"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Path parameter id"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-privileges": [
          "delete:pro:devices"
        ]
      }
    },
    "/v1/tenant/{tenantId}/devices/{id}/applications": {
      "parameters": [
        {
          "$ref": "#/components/parameters/DeviceId"
        }
      ],
      "get": {
        "summary": "Get installed applications for a device",
        "description": "Retrieve a paginated list of applications installed on a specific device\n\n**Required Permissions:** `read:pro:devices`",
        "tags": [
          "devices"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/tenantId"
          },
          {
            "$ref": "#/components/parameters/PageIndex"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "$ref": "#/components/parameters/InstalledApplicationSort"
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter query in RSQL format. Includes all results, by default.</br> Fields allowed in the query: `name`, `version`.</br> Example: `name==\"*Safari*\" and version>=\"26.0.0\"`",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Path parameter id"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of installed applications",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedDeviceInstalledApplicationReadRepresentationV1"
                }
              }
            }
          }
        },
        "x-authentication-required": true,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-privileges": [
          "read:pro:devices"
        ]
      }
    },
    "/v1/tenant/{tenantId}/users/{id}/devices": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UserId"
        }
      ],
      "get": {
        "summary": "Get devices for a user",
        "description": "Retrieve a paginated list of devices associated with a specific user\n\n**Required Permissions:** `read:pro:devices`",
        "tags": [
          "users"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/tenantId"
          },
          {
            "$ref": "#/components/parameters/PageIndex"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "$ref": "#/components/parameters/DeviceSort"
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter query in RSQL format. Includes all results, by default.</br> Fields allowed in the query: `id`, `name`, `model`, `modelIdentifier`, `serialNumber`, `lastInventoryUpdateTime`, `lastCheckInTime`, `operatingSystemVersion`, `enrollmentType`, `lastEnrollmentTime`.</br> Dates are specified in ISO 8601 format.</br> Example: `name==\"*iPhone*\" and lastInventoryUpdateTime>=\"2025-01-31T18:09:00.000Z\"`",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Path parameter id"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of devices for the user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedDeviceResponseRepresentation"
                }
              }
            }
          }
        },
        "x-authentication-required": true,
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-privileges": [
          "read:pro:devices"
        ]
      }
    }
  },
  "components": {
    "parameters": {
      "DeviceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "The ID of the device, in UUID format",
        "example": "616e6479-6973-6173-7461-6c6c696f6e21"
      },
      "UserId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "The ID of the user, in UUID format",
        "example": "616e6479-6973-6173-7461-6c6c696f6e21"
      },
      "PageIndex": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 0,
          "default": 0
        },
        "description": "Page number (0-based)"
      },
      "PageSize": {
        "name": "page-size",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "description": "Number of items per page"
      },
      "DeviceSort": {
        "name": "sort",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "default": "name"
        },
        "description": "Fields to sort by and their orders. Fields allowed in the query: `id`, `name`, `model`, `modelIdentifier`, `serialNumber`, `lastInventoryUpdateTime`, `lastCheckInTime`, `operatingSystemVersion`, `userId`, `enrollmentType`, `lastEnrollmentTime`",
        "example": "model:desc,name"
      },
      "InstalledApplicationSort": {
        "name": "sort",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "default": "name"
        },
        "description": "Fields to sort by and their orders. Fields allowed in the query: `name`, `version`",
        "example": "name,version:desc"
      },
      "tenantId": {
        "name": "tenantId",
        "in": "path",
        "required": true,
        "description": "The tenant UUID identifier",
        "schema": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "example": "e77c1408-10c8-4007-b177-abc9157fbcaa"
        }
      }
    },
    "schemas": {
      "DeviceListReadRepresentationV1": {
        "type": "object",
        "readOnly": true,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the device, in UUID format",
            "example": "616e6479-6973-6173-7461-6c6c696f6e21"
          },
          "name": {
            "type": "string",
            "description": "Name of the device",
            "example": "Some Device"
          },
          "model": {
            "type": "string",
            "description": "Model of the device",
            "example": "MacBook Pro (14-inch, 2024) M4 Pro"
          },
          "modelIdentifier": {
            "type": "string",
            "description": "Unique identifier of the device model",
            "example": "Mac16,8"
          },
          "serialNumber": {
            "type": "string",
            "description": "Serial number of the device",
            "example": "C02X12345678"
          },
          "lastInventoryUpdateTime": {
            "type": "string",
            "format": "date-time",
            "description": "The last time the device inventory was updated, in ISO 8601 format",
            "example": "2025-01-31T18:09:00.000Z"
          },
          "lastCheckInTime": {
            "type": "string",
            "format": "date-time",
            "description": "The last time the device checked in, in ISO 8601 format, or `null` if the device is not a computer",
            "example": "2025-01-31T18:09:00.000Z",
            "nullable": true
          },
          "operatingSystemVersion": {
            "type": "string",
            "description": "The operating system version of the device",
            "example": "macOS 14.0"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the user associated with the device, in UUID format, if assigned; otherwise, null",
            "example": "616e6479-6973-6173-7461-6c6c696f6e21",
            "nullable": true
          },
          "enrollmentType": {
            "type": "string",
            "description": "The type of enrollment of a device",
            "example": "Institutional"
          },
          "lastEnrollmentTime": {
            "type": "string",
            "format": "date-time",
            "description": "The last time the device was enrolled, in ISO 8601 format",
            "example": "2025-01-31T18:09:00.000Z"
          }
        },
        "required": [
          "id"
        ]
      },
      "DeviceReadRepresentationV1": {
        "type": "object",
        "readOnly": true,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the device, in UUID format",
            "example": "616e6479-6973-6173-7461-6c6c696f6e21"
          },
          "name": {
            "type": "string",
            "description": "Name of the device",
            "example": "Some Device"
          },
          "lastInventoryUpdateTime": {
            "type": "string",
            "format": "date-time",
            "description": "The last time the device inventory was updated, in ISO 8601 format",
            "example": "2025-01-31T18:09:00.000Z"
          },
          "lastCheckInTime": {
            "type": "string",
            "format": "date-time",
            "description": "The last time the device checked in, in ISO 8601 format, or `null` if the device is not a computer",
            "example": "2025-01-31T18:09:00.000Z",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the user associated with the device, in UUID format, if assigned; otherwise, null",
            "example": "616e6479-6973-6173-7461-6c6c696f6e21",
            "nullable": true
          },
          "enrollmentType": {
            "type": "string",
            "description": "The type of enrollment of a device",
            "example": "Institutional"
          },
          "lastEnrollmentTime": {
            "type": "string",
            "format": "date-time",
            "description": "The last time the device was enrolled, in ISO 8601 format",
            "example": "2025-01-31T18:09:00.000Z"
          },
          "managed": {
            "type": "boolean",
            "description": "Whether the device is managed",
            "example": true
          },
          "mdmCapable": {
            "type": "boolean",
            "description": "Whether the device is capable of communicating via MDM\n\nNote: This field will be `false` for Jamf Pro versions prior to 11.27.0, regardless of the MDM capability of the device\n",
            "example": true
          },
          "supervised": {
            "type": "boolean",
            "description": "Whether the device is supervised",
            "example": true
          },
          "hardware": {
            "$ref": "#/components/schemas/DeviceHardwareReadRepresentationV1"
          },
          "network": {
            "$ref": "#/components/schemas/DeviceNetworkReadRepresentationV1"
          },
          "operatingSystem": {
            "$ref": "#/components/schemas/DeviceOperatingSystemReadRepresentationV1"
          },
          "security": {
            "$ref": "#/components/schemas/DeviceSecurityReadRepresentationV1"
          }
        },
        "required": [
          "id"
        ]
      },
      "DeviceHardwareReadRepresentationV1": {
        "type": "object",
        "readOnly": true,
        "properties": {
          "make": {
            "type": "string",
            "description": "Make of the device",
            "example": "Apple"
          },
          "model": {
            "type": "string",
            "description": "Model of the device",
            "example": "MacBook Pro (14-inch, 2024) M4 Pro"
          },
          "modelIdentifier": {
            "type": "string",
            "description": "Unique identifier of the device model",
            "example": "Mac16,8"
          },
          "udid": {
            "type": "string",
            "description": "Unique device identifier (UDID) of the device",
            "example": "12345678-1234-1234-1234-123456789012"
          },
          "serialNumber": {
            "type": "string",
            "description": "Serial number of the device",
            "example": "C02X12345678"
          },
          "batteryHealth": {
            "type": "string",
            "description": "Battery health status of the device",
            "example": "NORMAL",
            "enum": [
              "NON_GENUINE",
              "NORMAL",
              "SERVICE_RECOMMENDED",
              "UNKNOWN",
              "UNSUPPORTED"
            ]
          },
          "macAddress": {
            "type": "string",
            "description": "MAC address of the device",
            "example": "00:1A:2B:3C:4D:5E"
          },
          "storageCapacity": {
            "type": "integer",
            "description": "Total storage capacity of the device, in megabytes",
            "example": 1000000
          },
          "storageUsed": {
            "type": "integer",
            "description": "Used storage space on the device, in megabytes",
            "example": 500000
          }
        }
      },
      "DeviceOperatingSystemReadRepresentationV1": {
        "type": "object",
        "readOnly": true,
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the operating system",
            "example": "macOS"
          },
          "version": {
            "type": "string",
            "description": "Version of the operating system",
            "example": 15.5
          },
          "build": {
            "type": "string",
            "description": "Build number of the operating system",
            "example": "24F74"
          },
          "supplementalBuildVersion": {
            "type": "string",
            "description": "Supplemental build version of the operating system, if applicable",
            "example": "24F74a",
            "default": null,
            "nullable": true
          },
          "rapidSecurityResponse": {
            "type": "string",
            "description": "Rapid security response version of the operating system, if applicable",
            "example": "(a)",
            "default": null,
            "nullable": true
          }
        }
      },
      "DeviceSecurityReadRepresentationV1": {
        "type": "object",
        "readOnly": true,
        "properties": {
          "bootstrapTokenEscrowedStatus": {
            "type": "string",
            "enum": [
              "NOT_SUPPORTED",
              "ESCROWED",
              "NOT_ESCROWED"
            ],
            "description": "The status of the bootstrap token for the device",
            "example": "ESCROWED"
          },
          "hardwareEncryption": {
            "type": "boolean",
            "description": "Whether hardware encryption is enabled on the device, or null if the device is a computer",
            "example": true,
            "nullable": true
          },
          "passcodePresent": {
            "type": "boolean",
            "description": "Whether a passcode is present on the device, or null if the device is a computer",
            "example": true,
            "nullable": true
          },
          "passcodeCompliant": {
            "type": "boolean",
            "description": "Whether the passcode on the device is compliant with the passcode policy, or null if the device is a computer",
            "example": true,
            "nullable": true
          },
          "lostModeEnabled": {
            "type": "boolean",
            "description": "Whether Lost Mode is enabled on the device, or null if the device is a computer",
            "example": false,
            "nullable": true
          }
        }
      },
      "DeviceNetworkReadRepresentationV1": {
        "type": "object",
        "readOnly": true,
        "properties": {
          "lastIpAddress": {
            "type": "string",
            "description": "The last observed IP address of the device, in either IPv4 or IPv6 format",
            "example": "123.45.67.89",
            "nullable": true
          },
          "lastReportedIpV4Address": {
            "type": "string",
            "description": "The last reported IPv4 address of the device, or null if not available or applicable",
            "example": "123.45.67.89",
            "nullable": true
          },
          "lastReportedIpV6Address": {
            "type": "string",
            "description": "The last reported IPv6 address of the device, or null if not available or applicable",
            "example": "2001:0db8:85a3:0000:000",
            "nullable": true
          }
        }
      },
      "DeviceInstalledApplicationReadRepresentationV1": {
        "type": "object",
        "readOnly": true,
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the installed application",
            "example": "Safari"
          },
          "version": {
            "type": "string",
            "description": "The version of the installed application",
            "example": "26.0.1"
          }
        }
      },
      "DeviceUpdateRepresentationV1": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the device. If provided, must not be empty.",
            "example": "Some Device"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the user to associate with the device, in UUID format. Set to null to unassign the device from any user. Defaults to empty string (no change to current assignment).",
            "example": "616e6479-6973-6173-7461-6c6c696f6e21",
            "default": "",
            "nullable": true
          }
        }
      },
      "PaginatedResponseRepresentation": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "description": "Current page number (0-based)",
            "example": 0
          },
          "pageSize": {
            "type": "integer",
            "description": "Number of items per page",
            "example": 20
          },
          "totalCount": {
            "type": "integer",
            "description": "Total number of results across all pages",
            "example": 150
          },
          "totalPages": {
            "type": "integer",
            "description": "Total number of pages",
            "example": 8
          },
          "hasNext": {
            "type": "boolean",
            "description": "Whether there is a next page",
            "example": true
          },
          "hasPrevious": {
            "type": "boolean",
            "description": "Whether there is a previous page",
            "example": false
          }
        },
        "required": [
          "page",
          "pageSize",
          "totalCount",
          "totalPages",
          "hasNext",
          "hasPrevious"
        ]
      },
      "PaginatedDeviceResponseRepresentation": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PaginatedResponseRepresentation"
          },
          {
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DeviceListReadRepresentationV1"
                },
