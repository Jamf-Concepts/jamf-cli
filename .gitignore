# Generated files (uncomment if you want to track generated code)
# internal/commands/generated_*.go

.claude/*
!.claude/settings.json
completions/

# Audit artifacts (local reference only, not committed)
codeql-results-*.sarif
gitleaks-results-*.txt
*-concepts-audit-report-*.md
*-concepts-audit-report-*.pdf

# Site build artifacts — all three are regenerated by `generator/site` on
# every deploy (see .github/workflows/deploy-site.yaml). They live in the
# deployed Pages site, not in the repo: AI agents fetch them at
# https://jamf-concepts.github.io/jamf-cli/{commands.json,llms.txt,llms-full.txt}
# per the llmstxt.org convention. Tracking them in git would just add
# multi-thousand-line diffs on every release with no consumer.
docs/site/commands.json
docs/site/llms.txt
docs/site/llms-full.txt

# Brainstorm sessions
.superpowers/

# Private spec sources (synced into specs/platform/ via make sync-platform-specs)
specs/.platform-source/

# Private spec sources (synced into specs/security/ via make sync-security-specs)
specs/.security-source/

# Transient: the SDK revision captured by make sync-gateway-coverage
.gateway-sdk-rev
